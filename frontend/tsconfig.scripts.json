{
  /* Repo tooling that imports application source (scripts/validate-theme.ts
     reads src/theme.ts directly, so there is one source of truth for colour).
     It gets its own project rather than joining tsconfig.node.json because
     that one runs `moduleResolution: nodenext` for vite.config.ts, which
     rejects src/'s extensionless imports. Bundler resolution here matches how
     src/ is actually compiled, while `allowImportingTsExtensions` covers the
     explicit .ts specifiers Node's --experimental-strip-types needs at run
     time. DOM is absent on purpose: this runs in Node. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
