# Where the FastAPI backend lives. The default in src/api/client.ts already
# points at the local dev server, so this file is only needed when deploying.
VITE_API_URL=http://localhost:8000

# Neon Auth base URL, used directly in local dev only. Production goes through
# the same-origin /neon-auth rewrite in vercel.json.
VITE_NEON_AUTH_URL=
