# Copy this file to .env and fill in real values. .env is gitignored; this
# template is not (see the !**/.env.example negation in .gitignore).

# Fetch pipeline only (backend/pipeline/*) — read-write, upserts race data.
# Same value as the NEON_DATABASE_URL secret in GitHub Actions.
NEON_DATABASE_URL

# API only (backend/api/) — a read-only Neon role, which is why it is a
# separate variable and not optional. See DEPLOYMENT.md for the grants.
NEON_DATABASE_URL_RO

# docker-compose.yml's local Postgres container only — nothing to do with Neon.
# These two match the psql flags in readme.md; changing them breaks that command.
POSTGRES_USER=f1user
POSTGRES_DB=f1tracker
POSTGRES_PASSWORD=change-me-any-local-value
